# The working tree is LF-only on every platform, not just in the object store. Git for Windows
# defaults to `core.autocrlf=true`, which checks text out with CRLF while `git status` stays
# clean, and Biome's formatter (`lineEnding: "lf"`) then fails every checked file on Windows.
# `eol=lf` overrides `core.autocrlf` per checkout, so no contributor has to reconfigure Git;
# `text=auto` keeps binary detection for files added later.
* text=auto eol=lf

# The Test Tables tab's recorded bundle holds a CR and a CRLF inside quoted CSV fields on
# purpose (its parser's quoting cases); its bytes are the CLI's and are never normalised
# (packages/tools/tests/test_test_tables_panel_fixtures.py).
vscode_extension/src/fixtures/test-tables/*.csv -text
