{
  "name": "swcraft-vscode",
  "displayName": "SWCraft",
  "description": "VS Code integration for SWCraft: project detection, the SWCraft MCP server for Agent mode, toolchain install and health, CLI passthrough commands, and the model check's findings in the Problems panel. Never writes an architecture model file directly: a quick fix is an edit of the open buffer the user applies and saves.",
  "version": "0.24.0",
  "publisher": "swcraft-local",
  "icon": "media/icon-128-color.png",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SWCraft runs code against the folder. Every command that reaches the model spawns the installed `swcraft` executable with the workspace's own manifest and model as its input, and the extension registers an MCP server that starts a second process against that same workspace. Trust the folder to get the SWCraft view and its commands back."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "SWCraft spawns the `swcraft` CLI as a local process against on-disk paths, so it needs a workspace backed by a real file system."
    }
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "AI",
    "Extension Packs"
  ],
  "activationEvents": [
    "workspaceContains:swcraft.yaml",
    "onCommand:swcraft.onboardProject",
    "onCommand:swcraft.openGuide",
    "onCommand:swcraft.installToolchain",
    "onCommand:swcraft.updateToolchain",
    "onUri"
  ],
  "extensionPack": [
    "redhat.vscode-yaml",
    "redhat.vscode-xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "SWCraft",
      "properties": {
        "swcraft.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the swcraft executable to run. Leave empty to use the workstation installation (%LOCALAPPDATA%\\SWCraft\\current\\Scripts\\swcraft.exe on Windows, ~/.swcraft/current/bin/swcraft elsewhere). Set it only for development against a SWCraft checkout, e.g. /path/to/swcraft/.venv/bin/swcraft; when it is set, nothing else is looked for."
        },
        "swcraft.experiments.allocation.config": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The configuration file the **Allocation (CARMA)** experiment runs with: a path relative to the project directory, passed to `swcraft experiment allocation` as `--config`. Leave empty to run the experiment with its defaults."
        },
        "swcraft.experiments.trace.config": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The configuration file the **Trace Links** search runs with: a path relative to the project directory, passed to `swcraft experiment trace` as `--config`. Leave empty to search with the defaults (every document reviewed)."
        },
        "swcraft.requirementsImport.mapping": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The mapping file **Import Requirements** last used: how the requirements team's need types and field names map to SWCraft's, passed to `swcraft import requirements` as `--mapping`. A path relative to the project directory, or an absolute path for a file outside it. The import writes it when a mapping file is picked and clears it when *SWCraft's own names* is picked; leave empty to import with SWCraft's own names. Only the workspace folder's own value (its `.vscode/settings.json`) is read: a value in your user settings is not used."
        },
        "swcraft.testTables.annotations": {
          "type": "string",
          "scope": "resource",
          "markdownDescription": "The test team's annotations folder **Test Tables** last used: the folder of the test team's columns, passed to `swcraft generate test-tables` as `--annotations`. A path relative to the project directory, or an absolute path for a folder outside it. Asked on the first press and written here; an empty value means *none yet* (generate without annotations), and no value at all means the next press asks. Only the workspace folder's own value (its `.vscode/settings.json`) is read: a value in your user settings is not used."
        },
        "swcraft.metricsSince": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The git revisions **Architecture Metrics** compares the working tree against, each passed to `swcraft metrics` as one `--since`: the first is the base, the others are points of the series, in this order. Leave empty to compare against `HEAD`; when `HEAD` cannot be read, the report says why and still shows the state."
        }
      }
    },
