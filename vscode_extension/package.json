    "viewsWelcome": [
      {
        "view": "swcraftReview",
        "contents": "No change set is waiting for your review.\nA change set waits here when an assistant whose SWCraft server runs with the panel review (`SWCRAFT_REVIEW=panel`) proposes one. Its review tab opens by itself; this list reopens a tab you closed unanswered."
      },
      {
        "view": "swcraftResources",
        "contents": "A green Build fills this view with each core's and memory's budget, use and headroom. Resource Report fills it without building and opens the report in a tab.\n[Resource Report](command:swcraft.resourceReport)"
      },
      {
        "view": "swcraftImpact",
        "contents": "Ask what depends on an element: open its file and choose SWCraft: Impact of This Element from the editor's context menu or the Command Palette."
      }
