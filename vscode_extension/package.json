          "command": "swcraft.traceOtherElement",
          "when": "view == swcraftTrace && viewItem == trace.other && !swcraft.trace.busy",
          "group": "1_decide@6"
        },
        {
          "command": "swcraft.traceOpenElement",
          "when": "view == swcraftTrace && viewItem =~ /^trace\\.(row|chosen|awaiting|linked|done)/",
          "group": "2_open@1"
        },
