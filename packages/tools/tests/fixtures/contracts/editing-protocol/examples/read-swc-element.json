        "layer": "swc",
        "element": "ExampleSWC"
      },
      {
        "layer": "interfaces",
        "element": "IExample"
      },
      {
        "layer": "hardware",
        "element": "RAM0"
      }
    ],
    "notes": "A read needs no approved scope, carries no baseline token and produces no audit record."
