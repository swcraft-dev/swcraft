{
  "name": "create-unit-linear-and-application-type",
  "description": "One change set declares a unit, a linear compu method naming it (`unit`), a data constraint, and an application type naming all three by reference (`unit_ref`, `compu_method_ref`, `data_constr_ref`) — contract `8.0.0`'s data description elements, each an element of its own layer. The type states none of the three inline: each reference field is exclusive with its inline form, and a type that names an element generates no private form of its own.",
  "kind": "example",
  "context": {
    "summary": "The `examples/basic` model, whose `units`, `compu_methods` and `data_constraints` layers are empty. No application type of the name the change set creates exists.",
    "baseline_state": "current",
    "authorization": {
      "approved_scope": [
        {
          "operation": "create",
          "address": {
            "layer": "units",
            "element": "ProbeNewtonMetre"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "compu_methods",
            "element": "ProbeTorqueScale"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "data_constraints",
            "element": "ProbeTorqueLimits"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "application_types",
            "element": "ProbeTorque"
          }
        }
      ],
      "notes": "The scope covers every operation exactly, so the answer is the engine's and not the authorization boundary's."
    }
  },
  "input": {
    "operation": "change_set",
    "baseline": "rev1:9f4c2a7be3d18056",
    "intent": "Declare the probe torque's unit, scale and limits as elements and a type naming them.",
    "operations": [
      {
        "operation": "create",
        "address": {
          "layer": "units",
          "element": "ProbeNewtonMetre"
        },
        "value": {
