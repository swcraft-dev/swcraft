{
  "name": "update-requirement-version-confirming-links",
  "description": "An `update` of a requirement's `version` with `confirm_links: true`: the server confirms every `satisfies` link naming the requirement at another version, or at none, as ordinary operations run after the client's — a `remove` of the old member and a `create` of `REQ_EXAMPLE_001@2` in the same list (a `satisfies` list is a `whole_value` list: a link is added or removed, never edited in place), only the `remove` where the list already holds the new version — and the delta marks each of its rows `origin: \"server\"`. A port's bare link is confirmed like a stated one; the `derived_from` member of `REQ_EXAMPLE_002` is no link and is left alone.",
  "kind": "example",
  "context": {
    "summary": "The `examples/basic` model, seeded: `REQ_EXAMPLE_001` at version 1 is linked at `@1` from both components' own `satisfies`, by a bare id from `ExampleConsumerSWC`'s port `rIn`, and from `IExample` at both `@1` and `@2`; `REQ_EXAMPLE_002` derives from `REQ_EXAMPLE_001@1`.",
    "existing_elements": [
      {
        "layer": "requirements",
        "element": "REQ_EXAMPLE_001"
      },
      {
        "layer": "requirements",
        "element": "REQ_EXAMPLE_002"
      },
      {
        "layer": "swc",
        "element": "ExampleSWC"
      },
      {
        "layer": "swc",
        "element": "ExampleConsumerSWC",
        "path": [
          {
            "field": "ports"
          },
          {
            "member": "rIn"
          }
        ]
      },
      {
        "layer": "interfaces",
        "element": "IExample"
      }
    ],
    "baseline_state": "current"
  },
  "input": {
    "operation": "change_set",
    "baseline": "rev1:9f4c2a7be3d18056",
    "intent": "Raise REQ_EXAMPLE_001 to version 2 and confirm every link to it.",
    "operations": [
      {
        "operation": "update",
        "address": {
          "layer": "requirements",
          "element": "REQ_EXAMPLE_001",
          "path": [
            {
              "field": "version"
            }
          ]
        },
        "value": 2,
        "confirm_links": true
      }
    ]
  },
  "expected": {
