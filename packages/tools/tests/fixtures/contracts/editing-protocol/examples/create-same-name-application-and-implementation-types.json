{
  "name": "create-same-name-application-and-implementation-types",
  "description": "One change set declares an application type and an implementation type under ONE name, the mapping set that pairs them, and an interface with a data element on each side. Since contract `8.0.0` identity is `(layer, name)`, so the two creates are two identities and neither is an `identity-conflict`; a data element states the side of its type in one of two fields, `application_type` or `implementation_type`, and each is resolved in its own layer. Each type states its bounds inline and so generates a `SyntheticTorque_Range` of its own, into the package of its own layer, where the two do not collide.",
  "kind": "example",
  "context": {
    "summary": "The `examples/basic` model, whose `base_types` layer declares `float32_base`. Neither `application_types` nor `implementation_types` declares `SyntheticTorque`, and no mapping set or interface of the names the change set creates exists.",
    "existing_elements": [
      {
        "layer": "base_types",
        "element": "float32_base"
      }
    ],
    "baseline_state": "current",
    "authorization": {
      "approved_scope": [
        {
          "operation": "create",
          "address": {
            "layer": "application_types",
            "element": "SyntheticTorque"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "implementation_types",
            "element": "SyntheticTorque"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "mapping_sets",
            "element": "SyntheticTorqueMapping"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "interfaces",
            "element": "ISyntheticTorque"
          }
        }
      ],
      "notes": "The scope covers every create exactly, so the answer is the engine's and not the authorization boundary's."
    }
  },
  "input": {
    "operation": "change_set",
    "baseline": "rev1:9f4c2a7be3d18056",
    "intent": "Declare the synthetic torque's physical and stored views under one name, pair them, and carry each on the bus.",
