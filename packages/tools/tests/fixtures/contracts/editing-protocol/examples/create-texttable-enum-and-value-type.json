{
  "name": "create-texttable-enum-and-value-type",
  "description": "One change set declares a texttable compu method with two entries, an enumeration that states its values by naming it (`compu_method_ref`, and no `literals`), and an implementation value type naming the same table — one table shared by an application type and an implementation type, as contract `8.0.0`'s elements allow. An implementation type has no inline counterpart: a referenced table is the only way it states its values.",
  "kind": "example",
  "context": {
    "summary": "The `examples/basic` model, whose `base_types` layer declares `uint8_base` and whose `compu_methods` layer is empty.",
    "existing_elements": [
      {
        "layer": "base_types",
        "element": "uint8_base"
      }
    ],
    "baseline_state": "current",
    "authorization": {
      "approved_scope": [
        {
          "operation": "create",
          "address": {
            "layer": "compu_methods",
            "element": "ProbeGearTable"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "application_types",
            "element": "ProbeGear"
          }
        },
        {
          "operation": "create",
          "address": {
            "layer": "implementation_types",
            "element": "ProbeGearRaw"
          }
        }
      ],
      "notes": "The scope covers every operation exactly, so the answer is the engine's and not the authorization boundary's."
    }
  },
  "input": {
