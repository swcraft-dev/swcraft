          "full",
          "index"
        ],
        "default_form": {
          "layer": "summary",
          "collection": "summary",
          "element": "full",
          "field": "full"
        },
        "budget_wire_bytes": 80000,
        "hint_page_size": 50,
        "discover": {
          "forms": [
            "summary",
            "full",
            "baseline"
          ],
          "default_form": "baseline"
        },
        "derived": [
          {
