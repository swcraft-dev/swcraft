      },
      {
        "operation": "create",
        "address": {
          "layer": "swc",
          "element": "ExampleConsumerSWC",
          "path": [
            {
              "field": "ports"
            },
            {
              "member": "rStatus"
            }
          ]
        },
        "value": {
          "name": "rStatus",
          "direction": "require",
          "interface": "IStatusNarrow",
          "description": "Consumes the narrow status"
        }
      },
      {
        "operation": "create",
        "address": {
          "layer": "connectors",
          "element": "Status_Wide_to_Narrow"
        },
        "value": {
          "name": "Status_Wide_to_Narrow",
