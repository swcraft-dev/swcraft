            "swc": "ExampleSWC",
            "port": "pStatus"
          },
          "to": {
            "swc": "ExampleConsumerSWC",
            "port": "rStatus"
          },
          "description": "ExampleSWC satisfies IStatusNarrow with IStatusWide"
        }
      }
    ]
  },
