            },
            {
              "name": "level",
              "implementation_type": "uint8"
            }
          ],
          "description": "Speed with the level beside it"
        }
      },
      {
        "operation": "create",
        "address": {
          "layer": "interfaces",
          "element": "IStatusNarrow"
        },
        "value": {
          "name": "IStatusNarrow",
          "kind": "sender_receiver",
          "data_elements": [
            {
              "name": "speed",
              "implementation_type": "float32"
            }
          ],
          "description": "Just the speed"
        }
      },
      {
        "operation": "create",
        "address": {
          "layer": "swc",
          "element": "ExampleSWC",
          "path": [
            {
              "field": "ports"
            },
            {
              "member": "pStatus"
            }
          ]
        },
        "value": {
          "name": "pStatus",
          "direction": "provide",
          "interface": "IStatusWide",
          "description": "Publishes the wide status"
