<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-crafted, anonymized importer fixture.
  Mirrors a client-server interface with typed, directional arguments and an
  OPERATION-INVOKED-EVENT-driven runnable, using invented names only.
  No content copied from any real export.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Acme</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Chassis</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Types</SHORT-NAME>
              <ELEMENTS>
                <SW-BASE-TYPE>
                  <SHORT-NAME>uint8</SHORT-NAME>
                  <CATEGORY>FIXED_LENGTH</CATEGORY>
                  <BASE-TYPE-SIZE>8</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <NATIVE-DECLARATION>uint8</NATIVE-DECLARATION>
                </SW-BASE-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>uint8_impl</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Chassis/Types/uint8</BASE-TYPE-REF>
                        <SW-CALIBRATION-ACCESS>NOT-ACCESSIBLE</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
                <SW-BASE-TYPE>
                  <SHORT-NAME>int16</SHORT-NAME>
                  <CATEGORY>FIXED_LENGTH</CATEGORY>
                  <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>2C</BASE-TYPE-ENCODING>
                  <NATIVE-DECLARATION>int16_t</NATIVE-DECLARATION>
                </SW-BASE-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>int16_impl</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Chassis/Types/int16</BASE-TYPE-REF>
                        <SW-CALIBRATION-ACCESS>NOT-ACCESSIBLE</SW-CALIBRATION-ACCESS>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Interfaces</SHORT-NAME>
              <ELEMENTS>
                <CLIENT-SERVER-INTERFACE>
                  <SHORT-NAME>IBrakeControlService</SHORT-NAME>
                  <DESC>
                    <L-2 L="FOR-ALL">Brake control diagnostic service (anonymized fixture).</L-2>
                  </DESC>
                  <IS-SERVICE>false</IS-SERVICE>
                  <OPERATIONS>
                    <CLIENT-SERVER-OPERATION>
                      <SHORT-NAME>SetBrakeMode</SHORT-NAME>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE>
                          <SHORT-NAME>requestedMode</SHORT-NAME>
                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/Chassis/Types/uint8_impl</TYPE-TREF>
                          <DIRECTION>IN</DIRECTION>
                          <SERVER-ARGUMENT-IMPL-POLICY>USE-ARGUMENT-TYPE</SERVER-ARGUMENT-IMPL-POLICY>
                        </ARGUMENT-DATA-PROTOTYPE>
                        <ARGUMENT-DATA-PROTOTYPE>
                          <SHORT-NAME>acceptedMode</SHORT-NAME>
                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/Chassis/Types/uint8_impl</TYPE-TREF>
                          <DIRECTION>OUT</DIRECTION>
                          <SERVER-ARGUMENT-IMPL-POLICY>USE-ARGUMENT-TYPE</SERVER-ARGUMENT-IMPL-POLICY>
                        </ARGUMENT-DATA-PROTOTYPE>
                      </ARGUMENTS>
                    </CLIENT-SERVER-OPERATION>
                    <CLIENT-SERVER-OPERATION>
                      <SHORT-NAME>AdjustBrakeBias</SHORT-NAME>
                      <ARGUMENTS>
                        <ARGUMENT-DATA-PROTOTYPE>
                          <SHORT-NAME>biasAdjustment</SHORT-NAME>
                          <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/Chassis/Types/int16_impl</TYPE-TREF>
                          <DIRECTION>INOUT</DIRECTION>
                          <SERVER-ARGUMENT-IMPL-POLICY>USE-ARGUMENT-TYPE</SERVER-ARGUMENT-IMPL-POLICY>
                        </ARGUMENT-DATA-PROTOTYPE>
                      </ARGUMENTS>
                    </CLIENT-SERVER-OPERATION>
                  </OPERATIONS>
                </CLIENT-SERVER-INTERFACE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Components</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>BrakeControllerSwc</SHORT-NAME>
                  <DESC>
                    <L-2 L="FOR-ALL">Brake controller application component (anonymized fixture).</L-2>
                  </DESC>
                  <PORTS>
                    <R-PORT-PROTOTYPE>
                      <SHORT-NAME>rBrakeControlService</SHORT-NAME>
                      <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Acme/Chassis/Interfaces/IBrakeControlService</REQUIRED-INTERFACE-TREF>
                    </R-PORT-PROTOTYPE>
                  </PORTS>
                  <INTERNAL-BEHAVIORS>
                    <SWC-INTERNAL-BEHAVIOR>
                      <SHORT-NAME>BrakeControllerSwc_InternalBehavior</SHORT-NAME>
                      <EVENTS>
                        <OPERATION-INVOKED-EVENT>
                          <SHORT-NAME>OIE_SetBrakeMode</SHORT-NAME>
                          <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Acme/Chassis/Components/BrakeControllerSwc/BrakeControllerSwc_InternalBehavior/HandleSetBrakeMode</START-ON-EVENT-REF>
                          <OPERATION-IREF>
                            <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Acme/Chassis/Components/BrakeControllerSwc/rBrakeControlService</CONTEXT-R-PORT-REF>
                            <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Acme/Chassis/Interfaces/IBrakeControlService/SetBrakeMode</TARGET-REQUIRED-OPERATION-REF>
                          </OPERATION-IREF>
                        </OPERATION-INVOKED-EVENT>
                      </EVENTS>
                      <RUNNABLES>
                        <RUNNABLE-ENTITY>
                          <SHORT-NAME>HandleSetBrakeMode</SHORT-NAME>
                          <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                          <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                          <SYMBOL>HandleSetBrakeMode</SYMBOL>
                        </RUNNABLE-ENTITY>
                      </RUNNABLES>
                      <SUPPORTS-MULTIPLE-INSTANTIATION>false</SUPPORTS-MULTIPLE-INSTANTIATION>
                    </SWC-INTERNAL-BEHAVIOR>
                  </INTERNAL-BEHAVIORS>
                </APPLICATION-SW-COMPONENT-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
