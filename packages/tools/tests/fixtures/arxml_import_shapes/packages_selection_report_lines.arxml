<?xml version="1.0" encoding="utf-8"?>
<!--
  Shape fixture for the import report's reduction and rename lines under a
  `packages` selection. (An XML comment may not carry two adjacent hyphens, so
  the CLI option is written `packages` here and nowhere else.)

  /Acme/Kept holds a component, the interface it provides and the types that
  interface carries: Level, a bare application type twinned with an
  implementation type of its own name, so the import reports one app/impl
  twin collapse for it; Pressure, an application type beside an implementation
  type of its name that no mapping set pairs, which since contract 8.0.0 are two
  layers and both keep the name; and an application array also named Pressure,
  in a package of its own, which collides with the application Pressure inside
  ONE layer, so rule 2 renames it, Pressure_app.
  /Acme/Other holds three things the import reports about and a selection of
  Kept does not keep:
  * Gauge, a second bare same-name pair: a second twin collapse;
  * Speed, the same shape as Pressure: an application primitive, an
    implementation type and an application array of one name; the array is
    renamed by rule 2, Speed_app;
  * Cluster, a composition placing a prototype of a component type nothing
    here declares, whose bare name LevelSwc is already taken by the kept
    component: the external stub is renamed.
  Over the whole file the report carries two reductions and three renames. A
  selection of Kept writes Level, Pressure, Pressure_app, Word, ILevel and
  LevelSwc and nothing of Other, so its report carries the one reduction about
  Level and the one rename about Pressure.
  Invented names only; no content copied from any real export.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Acme</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>Kept</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Types</SHORT-NAME>
              <ELEMENTS>
                <SW-BASE-TYPE>
                  <SHORT-NAME>Word</SHORT-NAME>
                  <CATEGORY>FIXED_LENGTH</CATEGORY>
                  <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <NATIVE-DECLARATION>uint16</NATIVE-DECLARATION>
                </SW-BASE-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Level</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Kept/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Pressure</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Kept/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>AppTypes</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-PRIMITIVE-DATA-TYPE>
                  <SHORT-NAME>Level</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                </APPLICATION-PRIMITIVE-DATA-TYPE>
                <APPLICATION-PRIMITIVE-DATA-TYPE>
                  <SHORT-NAME>Pressure</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                </APPLICATION-PRIMITIVE-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Arrays</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-ARRAY-DATA-TYPE>
                  <SHORT-NAME>Pressure</SHORT-NAME>
                  <CATEGORY>ARRAY</CATEGORY>
                  <ELEMENT>
                    <SHORT-NAME>sample</SHORT-NAME>
                    <CATEGORY>VALUE</CATEGORY>
                    <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Kept/AppTypes/Pressure</TYPE-TREF>
                    <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                    <MAX-NUMBER-OF-ELEMENTS>4</MAX-NUMBER-OF-ELEMENTS>
                  </ELEMENT>
                </APPLICATION-ARRAY-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Mappings</SHORT-NAME>
              <ELEMENTS>
                <DATA-TYPE-MAPPING-SET>
                  <SHORT-NAME>KeptMaps</SHORT-NAME>
                  <DATA-TYPE-MAPS>
                    <DATA-TYPE-MAP>
                      <APPLICATION-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Kept/AppTypes/Level</APPLICATION-DATA-TYPE-REF>
                      <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/Kept/Types/Level</IMPLEMENTATION-DATA-TYPE-REF>
                    </DATA-TYPE-MAP>
                  </DATA-TYPE-MAPS>
                </DATA-TYPE-MAPPING-SET>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Interfaces</SHORT-NAME>
              <ELEMENTS>
                <SENDER-RECEIVER-INTERFACE>
                  <SHORT-NAME>ILevel</SHORT-NAME>
                  <IS-SERVICE>false</IS-SERVICE>
                  <DATA-ELEMENTS>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>level</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Kept/AppTypes/Level</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>pressure</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Kept/AppTypes/Pressure</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>pressures</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-ARRAY-DATA-TYPE">/Acme/Kept/Arrays/Pressure</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Components</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>LevelSwc</SHORT-NAME>
                  <PORTS>
                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>pLevel</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Acme/Kept/Interfaces/ILevel</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                  </PORTS>
                </APPLICATION-SW-COMPONENT-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>Other</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Types</SHORT-NAME>
              <ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Gauge</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Kept/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Speed</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/Kept/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>AppTypes</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-PRIMITIVE-DATA-TYPE>
                  <SHORT-NAME>Gauge</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                </APPLICATION-PRIMITIVE-DATA-TYPE>
                <APPLICATION-PRIMITIVE-DATA-TYPE>
                  <SHORT-NAME>Speed</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                </APPLICATION-PRIMITIVE-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Arrays</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-ARRAY-DATA-TYPE>
                  <SHORT-NAME>Speed</SHORT-NAME>
                  <CATEGORY>ARRAY</CATEGORY>
                  <ELEMENT>
                    <SHORT-NAME>sample</SHORT-NAME>
                    <CATEGORY>VALUE</CATEGORY>
                    <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Other/AppTypes/Speed</TYPE-TREF>
                    <ARRAY-SIZE-SEMANTICS>FIXED-SIZE</ARRAY-SIZE-SEMANTICS>
                    <MAX-NUMBER-OF-ELEMENTS>4</MAX-NUMBER-OF-ELEMENTS>
                  </ELEMENT>
                </APPLICATION-ARRAY-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Mappings</SHORT-NAME>
              <ELEMENTS>
                <DATA-TYPE-MAPPING-SET>
                  <SHORT-NAME>OtherMaps</SHORT-NAME>
                  <DATA-TYPE-MAPS>
                    <DATA-TYPE-MAP>
                      <APPLICATION-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Other/AppTypes/Gauge</APPLICATION-DATA-TYPE-REF>
                      <IMPLEMENTATION-DATA-TYPE-REF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/Other/Types/Gauge</IMPLEMENTATION-DATA-TYPE-REF>
                    </DATA-TYPE-MAP>
                  </DATA-TYPE-MAPS>
                </DATA-TYPE-MAPPING-SET>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Interfaces</SHORT-NAME>
              <ELEMENTS>
                <SENDER-RECEIVER-INTERFACE>
                  <SHORT-NAME>IGauge</SHORT-NAME>
                  <IS-SERVICE>false</IS-SERVICE>
                  <DATA-ELEMENTS>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>gauge</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Other/AppTypes/Gauge</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>speed</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/Acme/Other/AppTypes/Speed</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>speeds</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-ARRAY-DATA-TYPE">/Acme/Other/Arrays/Speed</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Components</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>GaugeSwc</SHORT-NAME>
                  <PORTS>
                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>pGauge</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Acme/Other/Interfaces/IGauge</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                  </PORTS>
                </APPLICATION-SW-COMPONENT-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Compositions</SHORT-NAME>
              <ELEMENTS>
                <COMPOSITION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>Cluster</SHORT-NAME>
                  <COMPONENTS>
                    <SW-COMPONENT-PROTOTYPE>
                      <SHORT-NAME>GaugePart</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Acme/Other/Components/GaugeSwc</TYPE-TREF>
                    </SW-COMPONENT-PROTOTYPE>
                    <SW-COMPONENT-PROTOTYPE>
                      <SHORT-NAME>RemotePart</SHORT-NAME>
                      <TYPE-TREF DEST="APPLICATION-SW-COMPONENT-TYPE">/Remote/Components/LevelSwc</TYPE-TREF>
                    </SW-COMPONENT-PROTOTYPE>
                  </COMPONENTS>
                </COMPOSITION-SW-COMPONENT-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
