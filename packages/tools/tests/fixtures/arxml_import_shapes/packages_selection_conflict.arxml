<?xml version="1.0" encoding="utf-8"?>
<!--
  Shape fixture: a conflicting pair of which a `packages` selection
  keeps exactly one member.

  (An XML comment may not carry two adjacent hyphens, so the CLI option is
  written `packages` here and nowhere else.)

  /Acme/TreeA and /Acme/TreeB are two parallel copies of one type cluster:
  Word (SW-BASE-TYPE) and Ratio (IMPLEMENTATION-DATA-TYPE over it). The two
  Words differ — 16 bits against 32 — so both groups are conflicting over the
  whole file, Ratio by inheritance. That is the shape of a conflicting group
  in a tool export.

  /Acme/App holds a component and the interface it needs, typed out of TreeA
  alone. A `packages` selection of /Acme/App whose dependency closure is taken
  after full mapping reaches TreeA's Ratio and not TreeB's, so exactly one
  member of each group survives, and the conflict is not a conflict: the user
  never asked about the other tree.

  Invented names only; no content copied from any real export.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Acme</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>TreeA</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Types</SHORT-NAME>
              <ELEMENTS>
                <SW-BASE-TYPE>
                  <SHORT-NAME>Word</SHORT-NAME>
                  <CATEGORY>FIXED_LENGTH</CATEGORY>
                  <BASE-TYPE-SIZE>16</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <NATIVE-DECLARATION>uint16</NATIVE-DECLARATION>
                </SW-BASE-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Ratio</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/TreeA/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>TreeB</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Types</SHORT-NAME>
              <ELEMENTS>
                <SW-BASE-TYPE>
                  <SHORT-NAME>Word</SHORT-NAME>
                  <CATEGORY>FIXED_LENGTH</CATEGORY>
                  <BASE-TYPE-SIZE>32</BASE-TYPE-SIZE>
                  <BASE-TYPE-ENCODING>NONE</BASE-TYPE-ENCODING>
                  <NATIVE-DECLARATION>uint16</NATIVE-DECLARATION>
                </SW-BASE-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                  <SHORT-NAME>Ratio</SHORT-NAME>
                  <CATEGORY>VALUE</CATEGORY>
                  <SW-DATA-DEF-PROPS>
                    <SW-DATA-DEF-PROPS-VARIANTS>
                      <SW-DATA-DEF-PROPS-CONDITIONAL>
                        <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Acme/TreeB/Types/Word</BASE-TYPE-REF>
                      </SW-DATA-DEF-PROPS-CONDITIONAL>
                    </SW-DATA-DEF-PROPS-VARIANTS>
                  </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>App</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>Interfaces</SHORT-NAME>
              <ELEMENTS>
                <SENDER-RECEIVER-INTERFACE>
                  <SHORT-NAME>IRatio</SHORT-NAME>
                  <IS-SERVICE>false</IS-SERVICE>
                  <DATA-ELEMENTS>
                    <VARIABLE-DATA-PROTOTYPE>
                      <SHORT-NAME>ratio</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/Acme/TreeA/Types/Ratio</TYPE-TREF>
                    </VARIABLE-DATA-PROTOTYPE>
                  </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>Components</SHORT-NAME>
              <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                  <SHORT-NAME>RatioSwc</SHORT-NAME>
                  <PORTS>
                    <P-PORT-PROTOTYPE>
                      <SHORT-NAME>pRatio</SHORT-NAME>
                      <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Acme/App/Interfaces/IRatio</PROVIDED-INTERFACE-TREF>
                    </P-PORT-PROTOTYPE>
                  </PORTS>
                  <INTERNAL-BEHAVIORS>
                    <SWC-INTERNAL-BEHAVIOR>
                      <SHORT-NAME>RatioSwc_InternalBehavior</SHORT-NAME>
                      <HANDLE-TERMINATION-AND-RESTART>NO-SUPPORT</HANDLE-TERMINATION-AND-RESTART>
                      <SUPPORTS-MULTIPLE-INSTANTIATION>false</SUPPORTS-MULTIPLE-INSTANTIATION>
                    </SWC-INTERNAL-BEHAVIOR>
                  </INTERNAL-BEHAVIORS>
                </APPLICATION-SW-COMPONENT-TYPE>
              </ELEMENTS>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
