        "BrakeTemperatureSensor",
        "BrakeThermalProtection"
      ],
      "mentions_none": [
        "DiagnosticManager",
        "InstrumentCluster",
        "VehicleStateManager",
        "NvM"
      ]
    }
  },
  "reference": {
    "ports": [
      "BrakeController.rRearBrakeTemperature (require)",
      "BrakeTemperatureSensor.pBrakeTemperature (provide)",
      "BrakeThermalProtection.rBrakeTemperature (require)"
    ],
    "computed_by": "swcraft query --request {address: {layer: swc}, members: ports, where: [{field: interface, equals: IBrakeTemperature}]}"
  }
}
