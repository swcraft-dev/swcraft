# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# SWCraft project defaults
# Optional path to a swcraft.yaml manifest. CLI --project arguments take priority.
SWCRAFT_MANIFEST=

# Optional system prompt override for swcraft-agent; without it the agent reads the prompt its
# package carries. Use an absolute path on Windows if you run the CLI outside the repo root.
# SWCRAFT_AGENT_SYSTEM_PROMPT=C:\path\to\my-agent-prompt.md

# SWCraft agent reliability
# Maximum self-correction retries after a validate/build failure; 0 means none. An empty,
# non-numeric or negative value falls back to 3. A value the client's tool-use round limit
# (`MAX_TOOL_ROUNDS`; each retry costs about two rounds) cannot hold is clamped, so the agent can
# still stop and report.
SWCRAFT_AGENT_MAX_BUILD_RETRIES=3

# Optional AUTOSAR XSD download mirror.
SWCRAFT_AUTOSAR_XSD_URL=

# Optional recursion limit used while xmlschema parses deep AUTOSAR XSD files.
SWCRAFT_XML_SCHEMA_RECURSION_LIMIT=100000
